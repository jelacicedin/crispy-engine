{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run current file",
            "type": "shell",
            "command": "if [ -f '${fileDirname}/CMakeLists.txt' ]; then cmake --preset default && cmake --build --preset default && './build/${fileDirnameBasename}'; else mkdir -p '${fileDirname}/build' && g++ -std=c++20 -Wall -Wextra -g -fsanitize=address,undefined '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}' && '${fileDirname}/build/${fileBasenameNoExtension}'; fi",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "autoDetect",
                    "${fileDirname}"
                ]
            }
        },
        {
            "label": "Build current file",
            "type": "shell",
            "command": "mkdir -p '${fileDirname}/build' && g++ -std=c++20 -Wall -Wextra -g -O0 -fsanitize=address,undefined '${file}' -o '${fileDirname}/build/${fileBasenameNoExtension}'",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake build current folder",
            "type": "shell",
            "command": "cmake --preset default && cmake --build --preset default",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "presentation": {
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "autoDetect",
                    "${fileDirname}"
                ]
            }
        },
        {
            "label": "CMake build and run current folder",
            "type": "shell",
            "command": "cmake --preset default && cmake --build --preset default && ./build/${fileDirnameBasename}",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "presentation": {
                "clear": true,
                "focus": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "autoDetect",
                    "${fileDirname}"
                ]
            }
        }
    ]
}
